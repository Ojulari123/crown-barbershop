{
  // The app tsconfig excludes e2e/ so `tsc --noEmit` (CI) does not need Playwright's types
  // for app code. Typecheck the specs with: npx tsc -p e2e --noEmit
  "extends": "../tsconfig.json",
  "compilerOptions": { "noEmit": true, "incremental": false, "types": ["node"] },
  "include": ["**/*.ts", "../playwright.config.ts"],
  "exclude": []
}
